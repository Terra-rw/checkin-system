# Copy this file to server/.env and fill in the values.
# On Render, add these under the service's Environment tab instead.

PORT=4000

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# The public address of the app, used in password-reset and invite emails.
# Example: https://checkin-system.onrender.com  (no trailing slash)
APP_URL=

# Platform owner: the account that creates and manages institutions (log in at /platform).
# Created on first start if no owner exists. If PLATFORM_OWNER_PASSWORD is empty,
# a random one is printed in the server log once.
PLATFORM_OWNER_NAME=Platform owner
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_PASSWORD=

# Upgrading from v1 (single institution)? Existing people, attendance and settings are
# moved into one institution with this code and name the first time v2 starts.
# Everyone then logs in at <APP_URL>/<code>, e.g. https://…/nga
DEFAULT_INSTITUTION_CODE=main
DEFAULT_INSTITUTION_NAME=My Institution

# SMTP settings for alerts, login codes, invites and password resets.
# Leave SMTP_HOST empty to print emails to the console instead (handy for testing).
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
#                SMTP_USER=you@gmail.com, SMTP_PASS=<an App Password, not your normal password>
# On hosts that block ports 465/587 (e.g. Render), try port 2525 with SMTP_SECURE=false.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Check-in System <no-reply@example.com>"

# Optional: where the SQLite database file lives (default: server/data.db)
# DB_PATH=

# Optional: memory limit (MB) for the background worker that builds reports (default 1024).
# A report that needs more fails with a clear message instead of crashing the server.
# On a 2 GB server, 768 is a safe value.
# REPORT_WORKER_MEMORY_MB=1024
