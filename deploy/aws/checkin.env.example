# Copy to /etc/checkin/checkin.env on the server (chmod 600, owned by root:checkin).
# Everything under /data is on the separate EBS volume and survives every deploy.

NODE_ENV=production
PORT=4000

# --- data (on the /data volume — never inside /opt/checkin)
DB_PATH=/data/checkin.db
UPLOAD_DIR=/data/uploads
BACKUP_DIR=/data/backups
KEEP=14

# --- app
APP_URL=https://checkin.example.com
JWT_SECRET=
PLATFORM_OWNER_NAME=Platform owner
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_PASSWORD=
REPORT_WORKER_MEMORY_MB=1024

# --- email (see server/.env.example)
SMTP_HOST=
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
